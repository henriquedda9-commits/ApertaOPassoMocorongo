programa{
    funcao inicio(){
        //tipos de dados NUMERICOS
        inteiro idade;
        real altura;
        //tipos de dados LITERAIS
        caracter turma
        cadeia nome
        //tipo LOGICO
        logico menorIdade

        escreva("Nome copleto: ")
        leia(nome)
        escreva("idade:")
        leia(idade)
        escreva("altura em METROS:")
        leia(altura)
        escreva("turma (uma letra):")
        leia(turma)
        
        menorIdade = idade < 18
        escreva("\n----------- FICHA CADASTRO -----------\n")
        escreva("nome:", nome,"\n")
        escreva("idade", idade,"\n")
        escreva("turma:", turma,"\n")
        escreva("altura", altura,"\n")
        escreva("É menor de idade?", menorIdade"\n")


    }
}
